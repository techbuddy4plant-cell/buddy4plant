{
  // Cloudflare Workers settings for buddy4plant
  "name": "buddy4plant",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // every page address serves the app (single-page app)
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // the website's own addresses - Cloudflare keeps the records and certificates for these
  "routes": [
    { "pattern": "buddy4plant.in", "custom_domain": true },
    { "pattern": "www.buddy4plant.in", "custom_domain": true }
  ],
  "workers_dev": true,
  // non-secret settings (same as in the Cloudflare dashboard); secrets are never stored here
  "vars": {
    "SHIPROCKET_EMAIL": "tech.buddy4plant@gmail.com",
    "SHIPROCKET_PICKUP_LOCATION": "Home"
  },
  // keep variables and secrets that were added in the Cloudflare dashboard when deploying
  "keep_vars": true
}
