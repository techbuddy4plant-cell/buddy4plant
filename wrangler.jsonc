{
  // Cloudflare Workers settings for buddy4plant
  "name": "buddy4plant",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // every page address serves the app (single-page app)
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // the website's own addresses - Cloudflare keeps the records and certificates for these
  "routes": [
    { "pattern": "buddy4plant.in", "custom_domain": true }
  ],
  "workers_dev": true,
  // keeps orders in step with Shiprocket (sends waiting orders, brings back AWB / courier / status)
  "triggers": { "crons": ["*/30 * * * *"] },
  // non-secret settings; SHIPROCKET_EMAIL and all passwords/keys are set only in the Cloudflare dashboard
  "vars": {
    "SHIPROCKET_PICKUP_LOCATION": "Home"
  },
  // keep variables and secrets that were added in the Cloudflare dashboard when deploying
  "keep_vars": true
}
