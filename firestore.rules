rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true ||
        request.auth.token.email == "admin@buddy4plant.com" ||
        request.auth.token.email == "admin@vanabotanica.com"
      );
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Public readable & manageable store catalogues
    match /products/{productId} {
      allow read, write: if true;
    }

    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /collections/{collectionId} {
      allow read, write: if true;
    }

    match /homepage/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Reviews: Public read & write
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Wishlist
    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{userId} {
      allow read, write: if true;
    }

    // Orders: Public create, read & update for checkout & order tracking
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Landscaping projects shown on Gardening Services / Projects pages (edited in Admin > Projects)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true; // TODO: restrict to admins once admin login uses Firebase Auth (see to-do A1/A2)
    }

    // Landscaping / gardening service enquiries from the website form
    match /serviceEnquiries/{enquiryId} {
      allow read, write: if true;
    }

    // Inventory & Analytics
    match /inventory/{productId} {
      allow read, write: if true;
    }
    
    match /analytics/{docId} {
      allow read, write: if true;
    }
  }
}
