# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (auto-loaded from firebase-applet-config.json if available)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Razorpay Payment Gateway Credentials (Server-side)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID=""


# WhatsApp Business (Cloud) API - automatic "you have raised a query" message after a Gardening Services enquiry.
# Main business number: +91 80048 81668 (connect it via WhatsApp Business app "coexistence" in Meta Business Manager).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ENQUIRY_TEMPLATE="enquiry_received"
WHATSAPP_TEMPLATE_LANG="en"
# Optional: alert to the owner for every new enquiry
WHATSAPP_OWNER_NUMBER="918004881668"
WHATSAPP_OWNER_TEMPLATE=""

# Admin photo uploads in production (the admin panel asks for this key once per session)
ADMIN_UPLOAD_KEY=""
